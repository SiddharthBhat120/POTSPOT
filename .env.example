# Where PotSpot keeps its database, trip photos and annotated videos.
# POTSPOT_DATA=data/app

# Two sightings closer than this (metres) on different rides are the same pothole.
MERGE_RADIUS_M=8

# Frames analysed per second of video. 15 tracks close potholes reliably at city speeds; 10 loses some.
SAMPLE_FPS=15

# Camera model for the size estimate: phone height above the road and where the horizon sits
# (fraction of the frame height from the top). Bike handlebar ~1.1 m, car dashboard ~1.3 m.
CAMERA_HEIGHT_M=1.2
HORIZON_FRAC=0.45

# Largest video upload, in MB.
MAX_UPLOAD_MB=1500

# 1 = never call OpenStreetMap (no road names, no map tiles in the PDF).
POTSPOT_OFFLINE=0
# Contact sent to Nominatim in the User-Agent, as its usage policy asks.
NOMINATIM_CONTACT=https://github.com/SiddharthBhat120/POTSPOT
